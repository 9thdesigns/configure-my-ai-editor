{
  "name": "configure-my-ai-editor",
  "productName": "Configure My AI Editor",
  "desktopName": "configure-my-ai-editor.desktop",
  "version": "0.1.0",
  "description": "Configure My AI Editor \u2014 a lightweight desktop text editor with a Code session panel, a terminal, and GitHub-aware workspaces, built on the same Electron setup as the Configure My AI desktop app.",
  "main": "src/main.js",
  "private": true,
  "author": "9th Designs",
  "repository": {
    "type": "git",
    "url": "https://github.com/9thdesigns/configure-my-ai-editor.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "start": "npm run build && electron .",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "pack": "npm run build && electron-builder --mac --dir",
    "pack:win": "npm run build && electron-builder --win --dir",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --mac --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "smoke": "npm run build && node scripts/smoke.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0"
  }
}
