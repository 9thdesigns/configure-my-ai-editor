<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The minimum hardened-runtime entitlements a JIT-ing Chromium needs.
     Nothing here touches the sandbox or private APIs; both are simply what
     lets V8 allocate executable memory under the hardened runtime that
     notarization requires. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
